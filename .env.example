# Copy to .env and fill in. Never commit .env.

# Your Grok key from https://console.x.ai (optional: without it the bot uses built-in replies)
XAI_API_KEY=
# Leave empty to auto-pick a fast Grok model your key can use
XAI_MODEL=

# Using a different model provider instead of Grok? Any OpenAI-compatible API works, for example:
#   Gemini (free tier, key from aistudio.google.com):
#               LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.5-flash-lite
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#   Ollama on your own machine: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional backup model, used while the main one is out of free quota (for example Groq or OpenRouter):
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Optional: seconds to wait for an answer (default 45), and how hard thinking models think (default low for Gemini)
LLM_TIMEOUT=
LLM_REASONING_EFFORT=

# Discord (optional). With a token set, python3 web.py also runs the Discord bot. Setup steps are in the README.
DISCORD_TOKEN=
# Only listen in these channels (names or IDs, comma-separated). Empty = every channel the bot can see.
DISCORD_CHANNELS=

# Web app (python3 web.py / Railway). SQUAD_DATA is where chats are saved; on Railway mount a volume at /data.
PORT=8080
SQUAD_DATA=data-web

# Group chat name(s) the bot may read, comma-separated. Find them with: python3 run.py chats
SQUAD_CHATS=Squad

# No group yet? Text yourself and put your own phone number or email here (as shown by: python3 run.py chats).
# That chat becomes a pretend group with the sample friends; start a message with "as Priya:" to play them.
SQUAD_TEST_CHAT=

# own = runs on your own Apple ID, bot messages start with the prefix below
# separate = a dedicated Apple ID signed into Messages (bot has its own contact)
SQUAD_ACCOUNT=own
SQUAD_PREFIX=🤖 

SQUAD_TZ=America/Phoenix
SQUAD_PROFILES=profiles
